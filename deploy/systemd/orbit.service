[Unit]
Description=ORBIT gateway
After=network-online.target tailscaled.service
Wants=network-online.target

[Service]
EnvironmentFile=/opt/orbit/orbit.env
EnvironmentFile=/opt/orbit/current/release.env
WorkingDirectory=/opt/orbit/current
# Optional model key: /etc/credstore/orbit.openai (root, 0600). Absent means replies are mock.
ImportCredential=orbit.*
ExecStart=/usr/local/bin/node src/main.ts
Restart=always
RestartSec=5
DynamicUser=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
NoNewPrivileges=yes

[Install]
WantedBy=multi-user.target
