#!/usr/bin/env bash
# orbit-job: the ORBIT job protocol for Claude cloud runners.
# Control files live in DragonflyAI-sh/orbit-work on branch orbit/<job-id>:
#   ORBIT writes  .orbit/brief.md, .orbit/steer/<n>.md
#   the runner    .orbit/started.json, .orbit/checkins.jsonl, .orbit/replies/<n>.md, .orbit/summary.md
# With --api and --token, every step also calls ORBIT back, and a check-in fetches steers queued through the API
# (the tool writes them into .orbit/steer/ so the git record stays complete). Git stays the record: if the API is
# unreachable the step still lands in git and reports api=failed.
set -uo pipefail

TOOL_VERSION=2
STATE_DIR="${ORBIT_JOB_STATE:-$HOME/.orbit-job}"

say() { echo "orbit-job: $*"; }
die() { echo "orbit-job: error: $*" >&2; exit 2; }
now() { date -u +%Y-%m-%dT%H:%M:%SZ; }

# Escapes a string for a JSON value.
json() {
  local s=$1
  s=${s//\\/\\\\}; s=${s//\"/\\\"}; s=${s//$'\n'/\\n}; s=${s//$'\r'/}; s=${s//$'\t'/\\t}
  printf '"%s"' "$s"
}

valid_id() { [[ $1 =~ ^[A-Za-z0-9][A-Za-z0-9._-]{0,63}$ ]]; }

load() {
  [ -f "$STATE_DIR/current" ] || die "no job started here; run: orbit-job start --job <id>"
  # shellcheck source=/dev/null
  . "$STATE_DIR/current"
}

# The orbit-work checkout: --control, else a checkout here or under $HOME whose origin is orbit-work.
find_control() {
  local d url
  for d in "$PWD" "$HOME"/* /home/user/*; do
    [ -d "$d/.git" ] || continue
    url=$(git -C "$d" remote get-url origin 2>/dev/null) || continue
    case "$url" in */orbit-work | */orbit-work.git) echo "$d"; return 0 ;; esac
  done
  return 1
}

api_on() { [ -n "${API:-}" ] && [ -n "${TOKEN:-}" ]; }

# POSTs one event to ORBIT. Prints the response body; fails quietly so git remains the fallback.
api_event() {
  api_on || return 2
  curl -fsS -m 15 -X POST -H "Authorization: Bearer $TOKEN" -H "content-type: application/json" \
    --data-binary @- "$API/v1/jobs/$JOB/events" 2>>"$STATE_DIR/api.err"
}

# Writes steers from an API response (JSON on stdin) into .orbit/steer/<n>.md if missing. Prints the numbers written.
write_steers() {
  command -v python3 >/dev/null || return 0
  python3 -c '
import json, os, sys
d = sys.argv[1]
try:
    steers = json.load(sys.stdin).get("steers", [])
except Exception:
    sys.exit(0)
os.makedirs(d, exist_ok=True)
for s in steers:
    n, text = s.get("n"), s.get("text")
    if not isinstance(n, int) or not isinstance(text, str):
        continue
    path = os.path.join(d, f"{n}.md")
    if not os.path.exists(path):
        with open(path, "w") as f:
            f.write(text.rstrip("\n") + "\n")
        print(n)
' "$CONTROL/.orbit/steer"
}

api_note() { # api_note <status-of-api-call>
  case "$1" in 0) echo "api=sent" ;; 2) echo "api=not-configured" ;; *) echo "api=failed" ;; esac
}

git_c() {
  if git -C "$CONTROL" config user.email >/dev/null; then
    git -C "$CONTROL" "$@"
  else
    git -C "$CONTROL" -c user.name="ORBIT job runner" -c user.email="orbit-job@users.noreply.github.com" "$@"
  fi
}

# Pushes the job branch, rebasing on what ORBIT pushed meanwhile. Prints the short commit id.
push() {
  local tries=0
  : >"$STATE_DIR/push.err"
  until git -C "$CONTROL" push -q origin "HEAD:refs/heads/$BRANCH" 2>>"$STATE_DIR/push.err"; do
    tries=$((tries + 1))
    [ "$tries" -ge 3 ] && return 1
    git_c pull -q --rebase origin "$BRANCH" 2>>"$STATE_DIR/push.err" || return 1
  done
  git -C "$CONTROL" rev-parse --short HEAD
}

# Commits the given control files, pushes, then sends the event to ORBIT if the API is configured.
# $1 message, $2 event JSON without sha (or "" for none), rest: files. Reports what actually happened.
record() {
  local message=$1 event=$2 sha git_ok=1 api_rc=2 body
  shift 2
  git -C "$CONTROL" add -- "$@" || return 1
  if ! git_c commit -q -m "$message" -- "$@"; then
    git_ok=0
  elif ! sha=$(push); then
    git_ok=0
  fi
  if [ -n "$event" ]; then
    body=${event%\}}
    [ "$git_ok" = 1 ] && body="$body,\"sha\":$(json "$sha")"
    body="$body}"
    printf '%s' "$body" | api_event >"$STATE_DIR/api.out"; api_rc=$?
  fi
  if [ "$git_ok" = 1 ]; then
    say "ok git=pushed $sha $(api_note "$api_rc")"
  else
    say "FAILED git=push-failed $(api_note "$api_rc")"
    sed 's/^/  /' "$STATE_DIR/push.err" >&2
  fi
  [ "$git_ok" = 1 ] || [ "$api_rc" = 0 ]
}

cmd_start() {
  local job="" control="" api="${ORBIT_JOB_API:-}" token="${ORBIT_JOB_TOKEN:-}"
  while [ $# -gt 0 ]; do
    case "$1" in
      --job) job=${2:-}; shift 2 ;;
      --control) control=${2:-}; shift 2 ;;
      --api) api=${2:-}; shift 2 ;;
      --token) token=${2:-}; shift 2 ;;
      *) die "unknown option: $1" ;;
    esac
  done
  valid_id "$job" || die "--job <id> is required (letters, digits, dot, underscore, dash)"
  if [ -z "$control" ]; then control=$(find_control) || die "cannot find the orbit-work checkout; pass --control <path>"; fi
  CONTROL=$(cd "$control" && pwd) || die "no such directory: $control"
  BRANCH="orbit/$job"
  mkdir -p "$STATE_DIR"
  git -C "$CONTROL" fetch -q origin "$BRANCH" 2>/dev/null || die "branch $BRANCH is not on origin; ORBIT pushes it, with the brief, before the job starts"
  git -C "$CONTROL" checkout -q -B "$BRANCH" FETCH_HEAD || die "could not check out $BRANCH"
  [ -f "$CONTROL/.orbit/brief.md" ] || die "$BRANCH has no .orbit/brief.md"
  case "$api" in "" | https://* | http://127.0.0.1:* | http://localhost:*) ;; *) die "--api must be an https:// URL" ;; esac
  API=${api%/}; TOKEN=$token; JOB=$job
  printf 'JOB=%q\nCONTROL=%q\nBRANCH=%q\nAPI=%q\nTOKEN=%q\n' "$job" "$CONTROL" "$BRANCH" "$API" "$TOKEN" >"$STATE_DIR/current"
  chmod 600 "$STATE_DIR/current"
  printf '{"job":%s,"at":%s,"host":%s,"tool":%d}\n' "$(json "$job")" "$(json "$(now)")" "$(json "$(hostname)")" "$TOOL_VERSION" >"$CONTROL/.orbit/started.json"
  record "orbit-job $job: started" '{"type":"started"}' .orbit/started.json || exit 1
  say "brief: $CONTROL/.orbit/brief.md"
}

cmd_checkin() {
  [ $# -ge 1 ] && [ -n "$1" ] || die 'usage: orbit-job checkin "<what you are doing>"'
  load
  local got="" files=(.orbit/checkins.jsonl) n ack=""
  # Steers queued through the API become files first, so this check-in's commit records them.
  if api_on && curl -fsS -m 15 -H "Authorization: Bearer $TOKEN" "$API/v1/jobs/$JOB/steers" >"$STATE_DIR/steers.json" 2>>"$STATE_DIR/api.err"; then
    got=$(write_steers <"$STATE_DIR/steers.json")
  fi
  for n in $got; do files+=(".orbit/steer/$n.md"); ack="$ack${ack:+,}$n"; done
  printf '{"at":%s,"status":%s}\n' "$(json "$(now)")" "$(json "$1")" >>"$CONTROL/.orbit/checkins.jsonl"
  record "orbit-job $JOB: checkin${got:+ (received steers $(echo $got))}" "{\"type\":\"checkin\",\"status\":$(json "$1"),\"ack\":[$ack]}" "${files[@]}" || exit 1
  cmd_steers
}

# Prints steers that have no reply yet. Always pulls first so new steers from ORBIT show up.
cmd_steers() {
  load
  git_c pull -q --rebase origin "$BRANCH" 2>/dev/null || say "could not pull $BRANCH; showing steers already here"
  local f n found=0
  for f in "$CONTROL"/.orbit/steer/*.md; do
    [ -e "$f" ] || continue
    n=$(basename "$f" .md)
    [ -e "$CONTROL/.orbit/replies/$n.md" ] && continue
    found=1
    echo "--- steer $n (reply with: orbit-job reply $n <file>)"
    cat "$f"
    echo
  done
  [ "$found" = 1 ] || say "no unanswered steers"
}

cmd_reply() {
  [ $# -eq 2 ] || die "usage: orbit-job reply <steer-number> <file>"
  local n=$1 file=$2
  [[ $n =~ ^[0-9]+$ ]] || die "steer number must be a whole number"
  [ -f "$file" ] || die "no such file: $file"
  load
  [ -f "$CONTROL/.orbit/steer/$n.md" ] || die "there is no steer $n"
  mkdir -p "$CONTROL/.orbit/replies"
  cp "$file" "$CONTROL/.orbit/replies/$n.md"
  record "orbit-job $JOB: reply $n" "{\"type\":\"reply\",\"n\":$n,\"text\":$(json "$(head -c 4000 "$file")")}" ".orbit/replies/$n.md" || exit 1
}

cmd_summary() {
  local status="" file=""
  while [ $# -gt 0 ]; do
    case "$1" in
      --status) status=${2:-}; shift 2 ;;
      *) file=$1; shift ;;
    esac
  done
  case "$status" in done | blocked | failed) ;; *) die "usage: orbit-job summary --status done|blocked|failed <file>" ;; esac
  [ -f "$file" ] || die "no such file: $file"
  load
  { printf -- '---\nstatus: %s\nat: %s\n---\n\n' "$status" "$(now)"; cat "$file"; } >"$CONTROL/.orbit/summary.md"
  record "orbit-job $JOB: summary ($status)" "{\"type\":\"summary\",\"status\":\"$status\",\"text\":$(json "$(head -c 4000 "$file")")}" .orbit/summary.md || exit 1
}

usage() {
  cat <<'U'
orbit-job: the ORBIT job protocol (git record, optional API callbacks)
  orbit-job start --job <id> [--api <url> --token <t>] [--control <dir>]   check out orbit/<id>, record the start
  orbit-job checkin "<status>"                                    record progress, then show new steers
  orbit-job steers                                                show steers that have no reply yet
  orbit-job reply <n> <file>                                      answer steer n
  orbit-job summary --status done|blocked|failed <file>           final summary; write one on every exit
U
}

case "${1:-}" in
  start) shift; cmd_start "$@" ;;
  checkin) shift; cmd_checkin "$@" ;;
  steers) shift; cmd_steers ;;
  reply) shift; cmd_reply "$@" ;;
  summary) shift; cmd_summary "$@" ;;
  -h | --help | help | "") usage ;;
  --version) echo "orbit-job $TOOL_VERSION" ;;
  *) usage >&2; exit 2 ;;
esac
